<!DOCTYPE html>
<html lang="pt-BR">
<%- include('partials/head') %>
<body>
  <%- include('partials/topbar') %>
  <div class="layout">
    <%- include('partials/sidebar') %>
    <main class="content">
      <h1><%= tech.name %></h1>
      <p><%= tech.description %></p>
      <div class="source-box">
        <strong>Fonte oficial:</strong> <%= tech.sourceLabel %><br>
        <code><%= tech.homepage %></code><br>
        <%= tech.pages.length %> páginas<%= escopoProva && tech.totalPages > tech.pages.length ? ' (escopo da prova; ' + tech.totalPages + ' na documentação completa)' : '' %><%= tech.ptCount ? ' (' + tech.ptCount + ' com versão oficial em português)' : '' %><%= tech.version ? ' · versão ' + tech.version : '' %>
        · baixado em <%= new Date(tech.downloadedAt).toLocaleDateString('pt-BR') %>
      </div>
      <% tech.categories.forEach(function(cat) { %>
        <details class="category-block" <%= tech.categories.length <= 8 ? 'open' : '' %>>
          <summary><%= cat.name %> <span class="count"><%= cat.pages.length %></span></summary>
          <ul class="page-list">
            <% cat.pages.forEach(function(p) { %>
              <li><a href="<%= p.href %>"><%= lang === 'pt' ? (p.ptTitle || (allowAuto && p.autoTitle) || p.title) : p.title %></a></li>
            <% }) %>
          </ul>
        </details>
      <% }) %>
    </main>
  </div>
</body>
</html>
