<nav class="sidebar">
  <% techs.forEach(function(t) { %>
    <% var current = currentTechId === t.id; %>
    <details class="sidebar-tech" data-tech="<%= t.id %>" <%= current ? 'open' : '' %>>
      <summary class="sidebar-tech-title <%= current ? 'active' : '' %>"><%= t.name %></summary>
      <div class="sidebar-tech-body" <%= current ? 'data-loaded' : '' %>>
        <% if (current) { %>
          <%- include('sidebar-tech', { tech: t }) %>
        <% } else { %>
          <a class="sidebar-overview" href="/docs/<%= t.id %>">Visão geral</a>
        <% } %>
      </div>
    </details>
  <% }) %>
</nav>
<script src="/static/js/sidebar.js"></script>
