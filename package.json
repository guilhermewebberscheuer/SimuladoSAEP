{
  "name": "sistema-documentacao",
  "version": "1.0.0",
  "description": "Sistema offline de consulta à documentação oficial (MDN, Node.js, Express, MySQL, mysql2, jsonwebtoken, bcrypt) para uso em prova sem internet.",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:prova": "node -e \"process.env.MODO_PROVA=1;require('./server')\"",
    "baixar-docs": "node scripts/baixar-docs.js",
    "traduzir": "node scripts/traduzir.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "cheerio": "^1.2.0",
    "ejs": "^3.1.10",
    "express": "^4.22.3",
    "marked": "^13.0.3",
    "minisearch": "^7.2.0"
  }
}
